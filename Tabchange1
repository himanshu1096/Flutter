  /// [tabNumber]：0：QR処理（Business3000）／1：関連業務待機（Business6110）
  /// ※ログイン直後のQR読取表示では送らない
  Future<ProcessResponse> sendTabChange(int tabNumber) async {
    AppLogger().info(_tag, '0x0B81 画面タブ切替要求 送信: TABNUMBER=$tabNumber');
    _tabChangeCompleter = Completer<ProcessResponse>();
    await sendPacket(
      commandId: CommandId.tabChangeRequest,
      json: {'TABNUMBER': tabNumber},
    );
    return _tabChangeCompleter!.future.timeout(
      Duration(seconds: TcpConfig().responseTimeoutSec),
      onTimeout: () {
        AppLogger().error(_tag, '0x0B81 タイムアウト');
        _tabChangeCompleter = null;
        throw TimeoutException('画面タブ切替要求タイムアウト');
      },
    );
  }

