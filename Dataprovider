import 'package:riverpod_annotation/riverpod_annotation.dart';
import 'package:qr_multidemo/model/close_tally_data.dart';
import 'package:qr_multidemo/service/close_tally_file_service.dart';
part 'close_tally_data_provider.g.dart';

/// 締切表示データプロバイダー（締切テキストファイルの内容）
/// null：未読込、または読み込み失敗（画面は「－」表示）
@Riverpod(keepAlive: true)
class CloseTallyDataNotifier extends _$CloseTallyDataNotifier {
  @override
  CloseTallyData? build() => null;

  /// 締切テキストファイルを読み込む
  /// ※本体制御の応答受信後に呼ぶ（締切・締切速報・締切再出力）
  Future<void> load() async {
    state = await CloseTallyFileService().load();
  }

  void clear() => state = null;
}
