/// 保存済みのカメラ名を読み込む（Eドライブのファイル）
/// ファイルが無い・空・読込失敗の場合は null
Future<String?> loadSavedCameraName() async {
  try {
    final file = File(TcpConfig().cameraNamePath);
    if (!await file.exists()) return null;
    final name = (await file.readAsString()).trim();
    return name.isEmpty ? null : name;
  } catch (e) {
    AppLogger().error('CameraScanner', '★保存カメラ読込エラー', e);
    return null;
  }
}

/// 使用したカメラ名を保存する（Eドライブのファイル）
/// ※保存に失敗してもカメラ動作には影響させない（ログのみ）
Future<void> saveCameraName(String name) async {
  try {
    final file = File(TcpConfig().cameraNamePath);
    // フォルダが無い場合は作成する
    await file.parent.create(recursive: true);
    await file.writeAsString(name, flush: true);
    AppLogger().info('CameraScanner', '★カメラ名保存: $name');
  } catch (e) {
    AppLogger().error('CameraScanner', '★カメラ名保存エラー', e);
  }
}


