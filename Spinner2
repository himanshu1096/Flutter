    await sendPacket(
      commandId: CommandId.relationRequest,
      json: {'RELATIONNUMBER': relationNumber},
    );
    return _relationCompleter!.future.timeout(
      Duration(seconds: sec),
      onTimeout: () {
        AppLogger().error(_tag, '0x0C81 タイムアウト ($sec秒)');
        _relationCompleter = null;
        throw TimeoutException('関連業務選択要求タイムアウト');
      },
