/// 関連業務選択要求応答 (0x0C01) データモデル
/// COMMON：RESULT / ERRKIND / ERRCODE
/// DATA  ：PROPERTY1〜8（締切再出力のみ使用。締切履歴の日時、新しい順）
class RelationResponse {
  final bool result;
  final int errCode;
  final int errKind;

  /// PROPERTY1〜8 の日時（常に8件）
  /// ※"0000/00/00 00:00:00"（履歴無し）・キー無し・形式不正は null
  final List<DateTime?> properties;

  /// PROPERTYの件数
  static const int propertyCount = 8;

  const RelationResponse({
    required this.result,
    required this.errCode,
    required this.errKind,
    required this.properties,
  });

  factory RelationResponse.fromJson(Map<String, dynamic> json) {
    final common = json['COMMON'] as Map<String, dynamic>? ?? {};
    final data = json['DATA'] as Map<String, dynamic>? ?? {};
    return RelationResponse(
      result: common['RESULT'] as bool? ?? false,
      errCode: common['ERRCODE'] as int? ?? -1,
      errKind: common['ERRKIND'] as int? ?? -1,
      properties: [
        for (var i = 1; i <= propertyCount; i++)
          _parseDateTime(data['PROPERTY$i'] as String?),
      ],
    );
  }

  /// 「YYYY/MM/DD HH:MM:SS」→ DateTime
  /// ※"0000/…"（履歴無し）・不正な形式は null
  static DateTime? _parseDateTime(String? s) {
    if (s == null) return null;
    final v = s.trim();
    if (v.isEmpty || v.startsWith('0000')) return null;
    final parts = v.split(RegExp(r'\s+'));
    if (parts.length < 2) return null;
    final d = parts[0].split('/');
    final t = parts[1].split(':');
    if (d.length != 3 || t.length < 2) return null;
    final nums = [
      ...d.map(int.tryParse),
      ...t.map(int.tryParse),
    ];
    if (nums.contains(null)) return null;
    return DateTime(
      nums[0]!,
      nums[1]!,
      nums[2]!,
      nums[3]!,
      nums[4]!,
      t.length >= 3 ? nums[5]! : 0,
    );
  }

  @override
  String toString() =>
      'RelationResponse(result: $result, errCode: $errCode, errKind: $errKind, '
      'properties: $properties)';
}


