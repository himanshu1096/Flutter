    final sec = timeoutSec ?? TcpConfig().responseTimeoutSec;
    AppLogger().info(
      _tag,
      '0x0C81 関連業務選択要求 送信: RELATIONNUMBER=$relationNumber（タイムアウト$sec秒）',
    );
