  // カメラ方向を復元
  final prefs = await SharedPreferences.getInstance();
  final savedDirection = prefs.getString('camera_direction') ?? 'back';
  AppLogger().info('Main', 'カメラ方向復元: $savedDirection');


  runApp(
    ProviderScope(
      overrides: [
        currentCameraLensProvider.overrideWith(
          () => CurrentCameraLens()
            ..state = savedDirection == 'front'
                ? CameraLensDirection.front
                : CameraLensDirection.back,
        ),
