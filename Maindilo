  // 0x0A81 応答がエラーの場合、ログイン画面表示後にエラーダイアログを表示
  if (!initData.result) {
    WidgetsBinding.instance.addPostFrameCallback((_) {
      final context = navigatorKey.currentContext;
      if (context != null) {
        handleServerError(
          context: context,
          errKind: initData.errKind,
          errCode: initData.errCode,
        );
      }
    });
  }
