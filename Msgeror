  /// 0xFA81 — 本体制御異常ダイアログ表示 (エラー定義から取得)
  void _showSystemErrorDialog(int errKind, int errCode) {
    final context = navigatorKey.currentContext;
    if (context == null) return;
    handleServerError(
      context: context,
      errKind: errKind,
      errCode: errCode,
    ).then((result) {
      // 0x0F01 (シャットダウン) が定義されていればアプリ終了
      if (result.isAppExit) {
        sendAppExit();
      }
    });
  }



