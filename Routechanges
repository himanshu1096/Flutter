/// 精算金額プロバイダー (0x1381)
@Riverpod(keepAlive: true)
class FareAmount extends _$FareAmount {
  @override
  int? build() => null;

  void set(int amount) => state = amount;
  void clear() => state = null;
}


  // 再精算判定レスポンス Completer
  Completer<int>? _fareCompleter;



      // 再精算判定要求応答 (0x1381)
      case CommandId.fareJudgeResponse:
        AppLogger().info(_tag, '0x1381 再精算判定応答 受信');
        try {
          final data = packet.json['DATA'] as Map<String, dynamic>? ?? {};
          final amount = data['AMOUNT'] as int? ?? 0;
          AppLogger().info(_tag, '精算金額: $amount');
          _fareCompleter?.complete(amount);
          _fareCompleter = null;
        } catch (e) {
          AppLogger().error(_tag, '0x1381 パースエラー', e);
          _fareCompleter?.completeError(e);
          _fareCompleter = null;
        }
        break;


  /// 再精算判定要求送信 (0x1301) Flutter → Server
  Future<int> sendFareJudge(int keiro) async {
    AppLogger().info(_tag, '0x1301 再精算判定要求 送信: KEIRO=$keiro');
    _fareCompleter = Completer<int>();
    await sendPacket(
      commandId: CommandId.fareJudgeRequest,
      json: {'KEIRO': keiro},
    );
    return _fareCompleter!.future.timeout(
      const Duration(seconds: 180),
      onTimeout: () {
        AppLogger().error(_tag, '0x1301 タイムアウト');
        _fareCompleter = null;
        throw TimeoutException('再精算判定タイムアウト');
      },
    );
  }



