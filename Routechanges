/// 0x1301送信 → 0x1381受信 → 精算処理画面へ遷移
Future<void> _sendFareJudgeAndNavigate(
  BuildContext context,
  WidgetRef ref,
  int keiro,
) async {
  showCustomAlertDialog(context: context, text: '処理中');
  try {
    final amount = await TcpService().sendFareJudge(keiro);
    ref.read(fareAmountProvider.notifier).set(amount);
    if (context.mounted) Navigator.of(context).pop();
    if (context.mounted) {
      ref
          .read(qrReadPageSelectedBtnProvider.notifier)
          .changePage(QrReadPageBtnKind.seisanSyori);
    }
  } catch (e) {
    if (context.mounted) Navigator.of(context).pop();
    AppLogger().error('SeisanSyoriRoute', '再精算判定エラー', e);
    if (context.mounted) {
      await showDialog(
        context: context,
        barrierDismissible: false,
        builder: (context) => CustomConfirmDialog(
          text: '通信エラーが発生しました',
          trueBtnText: '確認',
          hasFalseBtn: false,
        ),
      );
    }
  }
}



