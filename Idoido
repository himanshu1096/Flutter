/// QRサーバ照会要求応答 (0x1181) データモデル
class QrServerResponse {
  final bool result;
  final int errCode;
  final int errKind;

  /// えきねっと接続結果（EKINETCONNECT）→ ヘッダーのQRアイコン
  /// null：DATAに無い（更新しない）
  final bool? ekinetConnect;

  /// iDONEO接続結果（IDONEOCONNECT）→ 接続状態画面のiDONEOカード
  /// ※IF仕様書は「iDONEOCONNECT」表記だが、実際のキーは「IDONEOCONNECT」
  /// null：DATAに無い（更新しない）
  final bool? idoneoConnect;

  const QrServerResponse({
    required this.result,
    required this.errCode,
    required this.errKind,
    this.ekinetConnect,
    this.idoneoConnect,
  });

  factory QrServerResponse.fromJson(Map<String, dynamic> json) {
    final common = json['COMMON'] as Map<String, dynamic>? ?? {};
    final data = json['DATA'] as Map<String, dynamic>? ?? {};
    return QrServerResponse(
      result: common['RESULT'] as bool? ?? false,
      errCode: common['ERRCODE'] as int? ?? -1,
      errKind: common['ERRKIND'] as int? ?? -1,
      ekinetConnect: data['EKINETCONNECT'] as bool?,
      idoneoConnect: data['IDONEOCONNECT'] as bool?,
    );
  }



      'QrServerResponse(result: $result, errCode: $errCode,errKind:$errKind, '
      'ekinet:$ekinetConnect, idoneo:$idoneoConnect)';


/// 業務処理実行要求応答 共通モデル
/// 0x2181/0x2281/0x2381/0x2481/0x2581/0xB181
/// ※印字要求応答（0xC181/0xC281）・ログオフ応答（0xA281）でも使用
class ProcessResponse {
  final bool result;
  final int errCode;
  final int errKind;

  /// えきねっと接続結果（EKINETCONNECT）→ ヘッダーのQRアイコン
  /// ※0x2181〜0x2581のみ。null：DATAに無い（更新しない）
  final bool? ekinetConnect;

  /// iDONEO接続結果（IDONEOCONNECT）→ 接続状態画面のiDONEOカード
  /// ※IF仕様書は「iDONEOCONNECT」表記だが、実際のキーは「IDONEOCONNECT」
  /// ※0x2181〜0x2581のみ。null：DATAに無い（更新しない）
  final bool? idoneoConnect;

  /// プリンタ接続結果（PRINTERCONNECT）→ ヘッダーのプリンタアイコン
  /// ※印字要求応答のみ。null：DATAに無い（更新しない）
  final bool? printerConnect;

  const ProcessResponse({
    required this.result,
    required this.errCode,
    required this.errKind,
    this.ekinetConnect,
    this.idoneoConnect,
    this.printerConnect,
  });

  factory ProcessResponse.fromJson(Map<String, dynamic> json) {
    final common = json['COMMON'] as Map<String, dynamic>? ?? {};
    final data = json['DATA'] as Map<String, dynamic>? ?? {};
    return ProcessResponse(
      result: common['RESULT'] as bool? ?? false,
      errCode: common['ERRCODE'] as int? ?? -1,
      errKind: common['ERRKIND'] as int? ?? -1,
      ekinetConnect: data['EKINETCONNECT'] as bool?,
      idoneoConnect: data['IDONEOCONNECT'] as bool?,
      printerConnect: data['PRINTERCONNECT'] as bool?,
    );
  }



      'ProcessResponse(result: $result, errCode: $errCode,errKind:$errKind, '
      'ekinet:$ekinetConnect, idoneo:$idoneoConnect, printer:$printerConnect)';




