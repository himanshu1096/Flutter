  /// フォントサイズを読み込む（8〜40pxに制限）
  /// 数値以外・範囲外の場合は既定値を使用する
  static double _readSize(dynamic value, double fallback) {
    final v = (value is num) ? value.toDouble() : null;
    if (v == null) return fallback;
    return v.clamp(8.0, 40.0);
  }

  /// 余白を読み込む（-20〜40pxに制限）
  static double _readPadding(dynamic value, double fallback) {
    final v = (value is num) ? value.toDouble() : null;
    if (v == null) return fallback;
    return v.clamp(-20.0, 40.0);
  }
