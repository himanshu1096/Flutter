class _SecondaryTabMenuWithActions extends HookWidget {
  final List<String> tabNames;
  final List<Widget> tabViews;
  final List<Widget> extraButtons;

  const _SecondaryTabMenuWithActions({
    required this.tabNames,
    required this.tabViews,
    required this.extraButtons,
  });

  @override
  Widget build(BuildContext context) {
    final tabController = useTabController(
      initialLength: tabViews.length,
      animationDuration: tabAnimationDuration,
    );

    return DecoratedContainer(
      child: Column(
        children: [
          Padding(
            padding: const EdgeInsets.all(8.0),
            child: AnimatedBuilder(
              animation: tabController.animation!,
              builder: (context, child) {
                return Row(
                  spacing: 8,
                  children: [
                    // 既存タブボタン
                    for (final MapEntry(key: index, value: tabName)
                        in tabNames.asMap().entries)
                      TransitionButton(
                        isPushed: tabController.index == index,
                        text: tabName,
                        onPressed: () {
                          tabController.animateTo(index);
                        },
                        width: 170.0,
                      ),
                    // 廃券処理・発駅キャンセルボタン
                    ...extraButtons,
                  ],
                );
              },
            ),
          ),
          Expanded(
            child: TabBarView(
              controller: tabController,
              physics: NeverScrollableScrollPhysics(),
              children: tabViews,
            ),
          ),
        ],
      ),
    );
  }
}






