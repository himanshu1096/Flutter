class LogOffScreen extends ConsumerWidget {
  /// ログオフ画面
  const LogOffScreen({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    return PaddingForContent(
      child: Center(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Text(
              'ログオフ処理を実施します。',
              style: TextStyle(fontSize: 50.0, fontWeight: FontWeight.w500),
            ),
            ActiveLargeButton(
              text: "実行    ",
              onPressed: () async {
                if (await showDialog<bool?>(
                      context: context,
                      builder: (context) => ConfirmDialog(porpose: 'ログオフ'),
                    )
                    case final isExecute? when isExecute && context.mounted) {
                  showCustomAlertDialog(context: context, text: '処理中');
                  try {
                    final response = await TcpService().sendLogoff();
                    if (context.mounted) Navigator.of(context).pop();
                    if (response.result) {
                      ref.read(displayDataNotifierProvider.notifier).clear();
                      ref.read(qrTicketNoProvider.notifier).reset();
                      if (context.mounted) {
                        context.goNamed(Pages.login.name);
                      }
                    } else {
                      if (context.mounted) {
                        await showDialog(
                          context: context,
                          barrierDismissible: false,
                          builder: (context) => CustomConfirmDialog(
                            text: 'ログオフに失敗しました',
                            trueBtnText: '確認',
                            hasFalseBtn: false,
                          ),
                        );
                      }
                    }
                  } catch (e) {
                    if (context.mounted) Navigator.of(context).pop();
                    AppLogger().error('LogOff', 'ログオフエラー', e);
                    if (context.mounted) {
                      await showDialog(
                        context: context,
                        barrierDismissible: false,
                        builder: (context) => CustomConfirmDialog(
                          text: '通信エラーが発生しました',
                          trueBtnText: '確認',
                          hasFalseBtn: false,
                        ),
                      );
                    }
                  }
                }
              },
            ),
          ],
        ),
      ),
    );
  }
