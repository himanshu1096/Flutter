/// エラー定義に基づくダイアログを表示する。
/// 戻り値: 押されたボタンのコマンド文字列 (例 "0xB101")。未定義なら空文字。
Future<String> showErrorDialog({
  required BuildContext context,
  required ErrorMessage error,
}) async {
  final b1 = error.button1;
  final b2 = error.button2;

  final pressedTrue = await showDialog<bool>(
    context: context,
    barrierDismissible: false,
    builder: (context) {
      return CustomConfirmDialog(
        text: error.message,
        trueBtnText: (b1?.text.isNotEmpty ?? false) ? b1!.text : '確認',
        falseBtnText: b2?.text ?? '',
        hasTrueBtn: true,
        hasFalseBtn: error.hasButton2,
      );
    },
  );

  // true=ボタン1, false=ボタン2
  if (pressedTrue == false && b2 != null) {
    return b2.command;
  }
  return b1?.command ?? '';
}




class ErrorResult {
  final bool handled;
  final String command;

  const ErrorResult({required this.handled, this.command = ''});
  static const notHandled = ErrorResult(handled: false);

  bool get isRetryPrint =>
      command == '0xC101' ||
      command == '0xC201' ||
      command == '0xC301' ||
      command == '0xC401' ||
      command == '0xC501';

  bool get isAppExit => command == '0x0F01';
  bool get isCancel => command == '0xB101';
