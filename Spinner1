/// 読み込み中のくるくる（円形プログレス）
/// 画面全体を薄暗くして操作不可にし、中央に回転する円を表示する
/// ※自動では消えないため、呼び出し元で
///   Navigator.of(context, rootNavigator: true).pop() で閉じる
void showLoadingSpinner({required BuildContext context}) {
  showDialog(
    context: context,
    useRootNavigator: true,
    barrierDismissible: false,
    builder:
        (context) => const Center(
          child: SizedBox(
            width: 120,
            height: 120,
            child: CircularProgressIndicator(strokeWidth: 10),
          ),
        ),
  );
}

