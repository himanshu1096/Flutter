class ProcessFailed extends StatelessWidget {
  const ProcessFailed({super.key, this.message, this.onCompleteButtonPressed});

  /// 失敗メッセージ (JSONから取得。nullなら既定メッセージ)
  final String? message;

  /// 確認ボタン押下時の処理
  final Future<void> Function()? onCompleteButtonPressed;

  @override
  Widget build(BuildContext context) {
    return _ProcessCompleteBase(
      message: message ?? "処理に失敗しました。",
      completeButtonLabel: '確認   ',
      onCompleteButtonPressed: onCompleteButtonPressed,
    );
  }
}

