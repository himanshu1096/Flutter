/// Excel風グリッドの1セル
/// 罫線は右・下を基本とし、見出し行のみ上にも引く
/// （隣り合うセルで罫線が二重にならないようにするため）
/// ※グリッドは枠の左右いっぱいに表示するため、左端の罫線は引かず、
///   最終列は右側の罫線も引かない（枠線と重ならないようにする）
class _GridCell extends StatelessWidget {
  const _GridCell({
    this.width,
    required this.child,
    this.alignment = Alignment.centerLeft,
    this.isLastColumn = false,
    this.isHeader = false,
  });

  /// セルの幅
  /// ※null の場合は親（Expanded）の幅に合わせる（最終列で使用）
  final double? width;

  /// セル内の表示内容
  final Widget child;

  /// セル内の配置（既定は左寄せ・上下中央）
  final Alignment alignment;

  /// 最終列か（右側の罫線を引かない）
  final bool isLastColumn;

  /// 見出し行か（背景色を変え、上側の罫線を引く）
  final bool isHeader;

  @override
  Widget build(BuildContext context) {
    const line = BorderSide(color: _gridLineColor, width: _gridLineWidth);
    return Container(
      width: width,
      alignment: alignment,
      padding: const EdgeInsets.symmetric(horizontal: 10),
      decoration: BoxDecoration(
        color: isHeader ? _gridHeaderColor : _gridRowColor,
        border: Border(
          top: isHeader ? line : BorderSide.none,
          right: isLastColumn ? BorderSide.none : line,
          bottom: line,
        ),
      ),
      // 文字は必ず1行で表示する
      // （列幅が足りない場合は折り返さず、収まるよう少しだけ縮小する）
      child: FittedBox(
        fit: BoxFit.scaleDown,
        alignment: alignment,
        child: child,
      ),
    );
  }
}

