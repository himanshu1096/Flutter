/// 磁気券処理の種別（③磁気券処理 仕様に対応）
/// データ行の有無は仕様で決まっており、精算処理のみデータ行あり。
/// ※2 処理内容はいずれも4文字の略称（発駅キャンセル → 発キャン）
enum _MagneticProcess {
  nyuzyou('入場処理', hasDataRow: false),
  syutuzyou('出場処理', hasDataRow: false),
  seisan('精算処理', hasDataRow: true),
  haiken('廃券処理', hasDataRow: false),
  hatuekiCancel('発キャン', hasDataRow: false);
  // nyusyutuzyouKakikae('入出場書換', hasDataRow: false),
  // renzokuBitKakikae('連続ビット書換', hasDataRow: false),
  // fuseiClear('不正クリア', hasDataRow: false);

  const _MagneticProcess(this.label, {required this.hasDataRow});
  final String label;
  final bool hasDataRow;
}

final TextStyle _btnTextStyle = TextStyle(fontSize: fontSize);

/// 「その他の日付」欄の文字サイズ
/// 日付ボタン（_btnTextStyle）と同じサイズにして見た目を揃える
const double _dateFieldFontSize = 28;

//==============================
// 接客履歴一覧のレイアウト定数
//==============================
/// 接客履歴1件分の各列の幅
/// ※列幅を固定することで、全行の文字が縦に揃うようにする
const double _colDateWidth = 110.0;
const double _colTimeWidth = 100.0;
const double _colNumberWidth = 160.0;

/// ※1 券種・※2 処理内容はいずれも4文字の略称
/// 4文字 × 28px ＋ セル左右の余白20px ＝ 132px のため、130pxでは2行に折り返す
/// → 処理内容は余裕を持たせて160pxとする
