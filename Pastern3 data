const double _colProcessWidth = 160.0;

/// 精算金額表（精算処理のみ）の幅
/// 「精算金額」4文字 ＋ 金額 ZZZZZ9円（最大6桁）
const double _amountTableWidth = 300.0;

/// 1行分の最小の高さ
