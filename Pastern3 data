///   （最後の行が途中で切れず、枠の下端までちょうど埋まるようにするため）
const double _historyMinRowHeight = 60.0;

/// 見出し行の高さ
const double _historyHeaderHeight = 44.0;

/// タイトルの下線とグリッドの間の余白
const double _gridTopGap = 10.0;

/// スクロール動作確認用のモックデータ件数
/// ※実データ接続時に削除する
