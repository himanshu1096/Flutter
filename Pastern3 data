class _HistoryView extends StatefulWidget {
  @override
  State<_HistoryView> createState() => _HistoryViewState();
}

class _HistoryViewState extends State<_HistoryView> {
  @override
  Widget build(BuildContext context) {
    final fontColor = Theme.of(context).colorScheme.onSecondaryContainer;
    final cardBackgroundColor =
        Theme.of(context).colorScheme.secondaryContainer;
    final cardOutlineColor = Theme.of(context).colorScheme.surfaceContainer;
    // ※共通部品 CardInfoBlock は ListTile のため左右に余白が入り、
    //   高さも内容に合わせて縮むので、グリッドを枠いっぱいに表示できない。
    //   そのため接客履歴のみ、同じ見た目の枠をこの画面内で組み立てる。
    return _HistoryCard(
      title: '接客履歴データ',
      fontColor: fontColor,
      cardBackgroundColor: cardBackgroundColor,
      cardOutlineColor: cardOutlineColor,
      icon: DualIconOverlay(
        baseIcon: Icons.person_2_outlined,
        topIcon: Icons.history_edu_outlined,
        baseColor: fontColor,
        topColor: fontColor,
        topBackgroundColor: cardBackgroundColor,
      ),
      child: DefaultTextStyle(
        style: TextStyle(fontSize: fontSize, color: Colors.black),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            // 見出し行（スクロールしても常に表示）
            const _HistoryHeader(),
            // 一覧：枠の下端までの残りの高さをすべて使う
            Expanded(
              child: LayoutBuilder(
                builder: (context, constraints) {
                  final items = _makeHistoryItemList();

                  // 枠内に収まる行数を求め、行の高さを少し広げて
                  // 下端までちょうど埋める（最後の行が途中で切れないようにする）
                  final available = constraints.maxHeight;
                  final rows = (available / _historyMinRowHeight).floor();
                  final rowHeight =
                      rows > 0 ? available / rows : _historyMinRowHeight;

                  return Scrollbar(
                    thumbVisibility: true,
                    child: ListView.builder(
                      padding: EdgeInsets.zero,
                      itemExtent: rowHeight,
                      itemCount: items.length,
                      itemBuilder: (context, index) => items[index],
                    ),
                  );
                },
              ),
            ),
          ],
        ),
      ),
    );
  }

  List<_HistoryItem> _makeHistoryItemList() {
    final todayStr = DateTime.now().toStringWithFormat('M/d');

    // スクロール確認用のモックデータ
    // 5業務を順番に繰り返して生成する（実データ接続時に差し替える）
    const processes = [
      _MagneticProcess.seisan,
      _MagneticProcess.nyuzyou,
      _MagneticProcess.syutuzyou,
      _MagneticProcess.haiken,
      _MagneticProcess.hatuekiCancel,
    ];

    // 金額は桁数の異なる値を用意し、列幅が足りるか確認できるようにする
    const amounts = ['1,020', '860', '2,340', '450', '12,600'];

    final List<_HistoryItem> items = [];
    // 6:37 から13分間隔で生成する
    var minutes = 6 * 60 + 37;

    for (var i = 0; i < _mockHistoryCount; i++) {
      final process = processes[i % processes.length];
      final hour = minutes ~/ 60;
      final minute = minutes % 60;

      items.add(
        _HistoryItem(
          date: todayStr,
          time: '$hour:${minute.toString().padLeft(2, '0')}',
          number: (7403 + i).toString().padLeft(8, '0'),
          ticketName: '普通券',
          processName: process.label,
          tableRows:
              process.hasDataRow
                  ? _seisanDataRows(amount: amounts[i % amounts.length])
                  : const [],
        ),
      );

      minutes += 13;
    }

    return items;
  }
}

/// 精算処理のデータ行（※3）
