}

/// 接客履歴データの枠
/// 共通部品 CardInfoBlock と同じ見た目（背景色・枠線・角丸・影・タイトル・下線）で、
/// タイトルの下線より下をすべて [child] に使わせる
/// （CardInfoBlock は ListTile のため左右に余白が入り、高さも内容に合わせて縮む）
class _HistoryCard extends StatelessWidget {
  const _HistoryCard({
    required this.title,
    required this.icon,
    required this.child,
    required this.fontColor,
    required this.cardBackgroundColor,
    required this.cardOutlineColor,
  });

  final String title;
  final Widget icon;
  final Widget child;
  final Color fontColor;
  final Color cardBackgroundColor;
  final Color cardOutlineColor;

  @override
  Widget build(BuildContext context) {
    final textStyle = titleTextStyle.copyWith(color: fontColor, height: 1.0);
    return Card.outlined(
      margin: const EdgeInsets.symmetric(vertical: 5),
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(Layouts.dialogRadius),
        side: BorderSide(color: cardOutlineColor, width: 2.0),
      ),
      color: cardBackgroundColor,
      elevation: 5.0,
      // グリッドの角を枠の角丸に合わせて切り取る
      clipBehavior: Clip.antiAlias,
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          // タイトル行（アイコン＋タイトル）
          Padding(
            padding: const EdgeInsets.fromLTRB(16, 10, 24, 0),
            child: Row(
              children: [
                icon,
                Padding(
                  padding: const EdgeInsets.only(left: 8.0),
                  child: Text(title, style: textStyle),
                ),
              ],
            ),
          ),
          // タイトルの下線
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 16),
            child: Divider(height: 12, thickness: 1.5, color: fontColor),
          ),
          // 下線とグリッドの間の余白
          const SizedBox(height: _gridTopGap),
          // 下線より下はすべてグリッドに使う（左右・下の余白なし）
          Expanded(child: child),
        ],
      ),
    );
  }
}

class _HistoryItem extends StatelessWidget {
  final String date;
  final String time;
  final String number;
  final String ticketName;
  final String processName;
  final List<TableRow> tableRows;

  const _HistoryItem({
    required this.date,
    required this.time,
    required this.number,
    required this.ticketName,
    required this.processName,
    required this.tableRows,
  });

  @override
  Widget build(BuildContext context) {
    // Excel風のグリッド：白背景のセルを罫線で区切る（枠の左右いっぱいに表示）
    // 各列は見出し行と同じ固定幅、行の高さは一覧側（itemExtent）で決めている
    // ※左端・右端の罫線は枠線と重なるため引かない
    return Row(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        _GridCell(width: _colDateWidth, child: Text(date)),
        _GridCell(width: _colTimeWidth, child: Text(time)),
        _GridCell(width: _colNumberWidth, child: Text(number)),
        // 4文字の略称は中央寄せにして、全行で文字位置を揃える
        _GridCell(
          width: _colTicketWidth,
          alignment: Alignment.center,
          child: Text(ticketName),
        ),
        _GridCell(
          width: _colProcessWidth,
          alignment: Alignment.center,
          child: Text(processName),
        ),
        // 最終列：残りの幅すべてを使うセル
        // 精算処理のみ、セルの中央に精算金額表を表示する
        // （データ行なしの行は空白セルとして罫線のみ表示する）
        Expanded(
          child: _GridCell(
            alignment: Alignment.center,
            isLastColumn: true,
            child:
                tableRows.isEmpty
                    ? const SizedBox.shrink()
                    : SizedBox(
                      width: _amountTableWidth,
                      child: TableInContent(children: tableRows),
                    ),
          ),
        ),
      ],
    );
  }
}

