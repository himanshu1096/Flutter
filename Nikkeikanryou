              Future<void> closePage() async {
                // ネストしたナビゲーターを取得する
                final navState = Navigator.of(context, rootNavigator: false);

                // 完了・失敗画面を表示したまま 0x0B01（TABNUMBER=0）→ 0x0B81 を待つ
                // ※先に画面を閉じると、応答待ちの間に日計締切画面が見えてしまうため
                //   true  → ＱＲ読取へ遷移済み
                //   false → エラーダイアログ表示済み（関連業務に留まる）
                await HomeTabData.of(context).goFirstTabDirect();

                // ネストしたナビゲーターの画面を元の締め切り画面に戻す
                // （成功時はＱＲ読取に切替済みのため見えない／失敗時は日計締切画面に戻る）
                if (navState.canPop()) {
                  navState.pop();
                }
              }

              return ok
                  // ? ProcessCompleted(onCompleteButtonPressed: closePage)
                  ? ProcessCompleted(onCompleteButtonPressed: closePage, move: false)
                  : ProcessFailed(
                    message: '処理が失敗しました。',
                    onCompleteButtonPressed: closePage,
                    move: false,
                  );
