import 'dart:typed_data';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import 'app_color.dart';
import 'camera_scanner.dart';
import 'config/camera_config.dart';
import 'provider/provider.dart';
import 'pop_out_button.dart';

/// ボタンのテキスト・スタイル
const TextStyle _btnTextStyle = TextStyle(
  fontSize: 20,
  fontWeight: FontWeight.w700,
);

class ScannerWidget extends ConsumerStatefulWidget {
  /// QRコード読み取りのカメラ画面
  const ScannerWidget({super.key});

  @override
  ConsumerState<ScannerWidget> createState() => _ScannerWidgetState();
}

class _ScannerWidgetState extends ConsumerState<ScannerWidget> {
  /// カメラ画面のコントローラ
  final CameraScannerController _controller = CameraScannerController();

  @override
  Widget build(BuildContext context) {
    // カメラの方向
    final cameraDirection = ref.watch(currentCameraLensProvider);
    debugPrint('Camera Direction:$cameraDirection');

    return Scaffold(
      appBar: AppBar(
        leadingWidth: 120,
        foregroundColor: Colors.white,
        backgroundColor: AppColor.indigo.no700,
        automaticallyImplyLeading: false,
        title: Row(
          children: [
            Transform.scale(
              scale: 1.3,
              child: PopOutButton(
                backgroundColors: [AppColor.blue.no50, AppColor.blue.no100],
                foregroundColor: AppColor.indigo.no700,
                onPressed: () {
                  Navigator.of(context).pop();
                },
                child: Row(
                  children: [
                    SizedBox(width: 5),
                    Icon(Icons.arrow_back, size: _btnTextStyle.fontSize),
                    SizedBox(width: 5),
                    Text('もどる', style: _btnTextStyle),
                    SizedBox(width: 5),
                  ],
                ),
              ),
            ),

            SizedBox(width: 30),

            // タイトル
            Expanded(child: Text('QRコードを読み取ってください')),
          ],
        ),
      ), // AppBar
      backgroundColor: Colors.black,
      body: CameraScanner(
        controller: _controller,
        lensDirection: cameraDirection,
        onDetected: (rawBytes) {
          Navigator.of(context).pop(rawBytes);
        },
      ), // CameraScanner
      floatingActionButton: FutureBuilder(
        future: _controller.canSwitchCamera,
        builder: (context, snapshot) {
          if (snapshot.hasData && (snapshot.data ?? false)) {
            return FloatingActionButton.large(
              backgroundColor: AppColor.indigo.no700,
              foregroundColor: Colors.white,
              onPressed: () async {
                // カメラ切り替え
                final currentDirection = await _controller.switchCamera();
                // 切り替え後のカメラ方向をプロバイダーに記録
                ref.read(currentCameraLensProvider.notifier).state =
                    currentDirection;
                // SharedPreferencesに保存
                await CameraConfig().save(currentDirection);
              },
              child: Icon(Icons.cameraswitch_outlined),
            ); // FloatingActionButton.large
          }

          return SizedBox.shrink();
        },
      ), // FutureBuilder
    ); // Scaffold
  }
}
