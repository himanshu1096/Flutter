Completer<ProcessResponse>? _printCompleter;

/// QR券情報ジャーナル印字要求送信 (0xC101)
Future<ProcessResponse> sendPrintQrInfo(String qrNumber) async {
  AppLogger().info(_tag, '0xC101 QR券情報ジャーナル印字要求 送信');
  _printCompleter = Completer<ProcessResponse>();
  await sendPacket(
    commandId: CommandId.printQrInfoRequest,
    json: {'QRNUMBER': qrNumber},
  );
  return _printCompleter!.future.timeout(
    const Duration(seconds: 30),
    onTimeout: () {
      AppLogger().error(_tag, '0xC101 タイムアウト');
      _printCompleter = null;
      throw TimeoutException('印刷タイムアウト');
    },
  );
}



