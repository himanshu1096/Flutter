  void _updateConnectionStatus(String unit, int? status) {
    if (status == null) {
      return;
    }
    _connectionStatus[unit] = status;
    _onConnectionStatusChanged?.call(unit, status);
  }

  /// 応答DATAの接続結果（Bool）で接続状態を更新する
  /// true：接続、false：未接続、null：DATAに無いため更新しない
  void _updateConnectResult(String unit, bool? connected) {
    if (connected == null) return;
    _updateConnectionStatus(
      unit,
      connected
          ? ConnectionStatusValue.connected
          : ConnectionStatusValue.disconnected,
    );
  }



