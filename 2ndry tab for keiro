/// 小さい文字（経由路線名など）のスタイル
TextStyle _subStyle(RouteLabel? label) => TextStyle(
  fontSize: label?.subFontSize ?? TcpConfig().routeBtnSubFontSize,
  fontWeight: FontWeight.w500,
);

/// 大きい文字（駅名など）のスタイル
TextStyle _mainStyle(RouteLabel? label) => TextStyle(
  fontSize: label?.mainFontSize ?? TcpConfig().routeBtnMainFontSize,
  fontWeight: FontWeight.w700,
);

/// 文字揃え（'left' / 'center' / 'right'）
TextAlign _textAlign(RouteLabel? label) {
  final v = label?.align ?? TcpConfig().routeBtnAlign;
  switch (v) {
    case 'left':
      return TextAlign.left;
    case 'right':
      return TextAlign.right;
    default:
      return TextAlign.center;
  }
}

/// Column内の横方向の寄せ（文字揃えに合わせる）
CrossAxisAlignment _crossAlign(RouteLabel? label) {
  switch (_textAlign(label)) {
    case TextAlign.left:
      return CrossAxisAlignment.start;
    case TextAlign.right:
      return CrossAxisAlignment.end;
    default:
      return CrossAxisAlignment.center;
  }
}



