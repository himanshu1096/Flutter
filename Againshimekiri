/// くるくるの最低表示時間（ミリ秒）
const int _spinnerMinMs = 300;

/// 締切履歴選択：くるくる表示 → 0x6401送信 → 0x6481待ち
///   RESULT=true  → 締切ファイルを読み直して true を返す
///   RESULT=false → エラーメッセージJSON（無ければ既定メッセージ）
///   タイムアウト → 「通信エラーが発生しました」
Future<bool> _selectCloseHistory(
  BuildContext context,
  WidgetRef ref,
  DateTime date,
) async {
  const tag = 'CloseTallyReExport';
  final closeTally = ref.read(closeTallyDataProvider.notifier);

  Future<void> showMessage(String text) async {
    if (!context.mounted) return;
    await showDialog(
      context: context,
      barrierDismissible: false,
      builder:
          (context) => CustomConfirmDialog(
            text: text,
            trueBtnText: '確認',
            hasFalseBtn: false,
          ),
    );
  }

  // くるくる（閉じるNavigatorを先に取得し、必ず1回だけ閉じる）
  final navigator = Navigator.of(context, rootNavigator: true);
  showLoadingSpinner(context: context);
  var spinnerOpen = true;
  void closeSpinner() {
    if (!spinnerOpen) return;
    spinnerOpen = false;
    navigator.pop();
  }

  final minWait = Future.delayed(const Duration(milliseconds: _spinnerMinMs));

  try {
    // ボタンの日時をPROPERTYと同じ形式で送る
    final response = await TcpService().sendCloseHistorySelect(
      date.toStringWithFormat('yyyy/MM/dd HH:mm:ss'),
    );

    if (response.result) {
      // 本体側で選択した締切が締切ファイルにコピーされているため読み直す
      await closeTally.load();
      await minWait;
      closeSpinner();
      return true;
    }

    AppLogger().warn(
      tag,
      '0x6481 失敗: ERRKIND=${response.errKind} ERRCODE=${response.errCode}',
    );
    closeSpinner();
    if (!context.mounted) return false;
    final result = await handleServerError(
      context: context,
      errKind: response.errKind,
      errCode: response.errCode,
    );
    if (!result.handled) {
      await showMessage('処理に失敗しました\nエラーコード: ${response.errCode}');
    }
    return false;
  } catch (e) {
    closeSpinner();
    AppLogger().error(tag, '締切履歴選択エラー', e);
    await showMessage('通信エラーが発生しました');
    return false;
  }
}




