    // 起動するカメラを選択する
    // Windowsでは複数カメラが全てfrontと報告されるため、
    // lensDirectionでは識別できない。保存済みカメラ名を優先する。
    CameraDescription? camera;
    try {
      final prefs = await SharedPreferences.getInstance();
      final savedName = prefs.getString('camera_name');
      if (savedName != null) {
        camera = _cameras.firstWhereOrNull((c) => c.name == savedName);
        AppLogger().info(
          'CameraScanner',
          '★保存カメラ名=$savedName 該当=${camera != null}',
        );
      }
    } catch (e) {
      AppLogger().error('CameraScanner', '★保存カメラ読込エラー', e);
    }
    // 保存が無い/見つからない場合は従来通りlensDirectionで選択
    camera ??= _cameras.firstWhere(
      (x) => x.lensDirection == widget.lensDirection,
      orElse: () => _cameras.first,
    );
    AppLogger().info('CameraScanner', '★使用カメラ=${camera.name}');



  /// 次のカメラに切り替え、切替後のカメラ名を返す
  Future<String> switchCameraByName() async {
    if (_controller case final controller?) {
      if (_cameras.length > 1) {
        final nextCamera = _getNextCamera();
        if (nextCamera != controller.description) {
          await controller.setDescription(nextCamera);
        }
        AppLogger().info('CameraScanner', '★切替後カメラ名=${nextCamera.name}');
        return nextCamera.name;
      }
      return controller.description.name;
    }
    throw Exception("カメラのコントローラがnullです。:switchCameraByName()");
  }



  /// カメラを切り替え、切替後のカメラ名を返す
  Future<String> switchCameraByName() async {
    return await _state.switchCameraByName();
  }



