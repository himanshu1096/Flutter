/// 動的駅名 — TCPで受信したPLACESTATIONを返す
/// 未受信の場合はフォールバック値を返す
String get dynamicStationName {
  final name = _tcpStationName;
  return (name != null && name.isNotEmpty) ? name : stationName;
}

String? _tcpStationName;

void setTcpStationName(String name) {
  _tcpStationName = name;
}



