Future<void> _openKeyboardDialog({
  required BuildContext context,
  required WidgetRef ref,
  required TextEditingController controller,
  required ValueNotifier<bool> disableQrReferenceButton,
}) async {
  final result = await showDialog<String?>(
    barrierDismissible: false,
    context: context,
    builder: (context) => SoftwareKeyboard(
      keyboardUsage: KeyboardUsage.qrTicketNo,
      initialText: controller.text,
    ),
  );
  if (result != null) {
    controller.text = result;
    if (result.length >= 1) {
      ref.read(qrTicketNoProvider.notifier).changeNo(result.replaceAll(' ', ''));
      disableQrReferenceButton.value = true;
    } else {
      disableQrReferenceButton.value = false;
    }
  } else {
    controller.text = '';
    ref.read(qrTicketNoProvider.notifier).reset();
    disableQrReferenceButton.value = false;
  }
}

