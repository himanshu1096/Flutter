class _HistoryViewState extends State<_HistoryView> {
  /// 現在のページ（0始まり）
  int _currentPage = 0;

  /// 総ページ数（最低1ページ）
  int get _totalPages {
    final count = _makeHistoryItemList().length;
    return count == 0 ? 1 : (count / _itemsPerPage).ceil();
  }

  /// 現在のページに表示する項目のみを切り出す
  List<_HistoryItem> _currentPageItems() {
    final all = _makeHistoryItemList();
    final start = _currentPage * _itemsPerPage;
    if (start >= all.length) return [];
    final end = (start + _itemsPerPage).clamp(0, all.length);
    return all.sublist(start, end);
  }

