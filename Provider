    JudgeRouteInfo(
      id: 1,
      buttonvisible: false,
      companypattern: 0,
      routepattern: 0,
      infopattern: 0,
    ),
    JudgeRouteInfo(
      id: 2,
      buttonvisible: false,
      companypattern: 0,
      routepattern: 0,
      infopattern: 0,
    ),
    JudgeRouteInfo(
      id: 3,
      buttonvisible: false,
      companypattern: 0,
      routepattern: 0,
      infopattern: 0,
    ),
    JudgeRouteInfo(
      id: 4,
      buttonvisible: false,
      companypattern: 0,
      routepattern: 0,
      infopattern: 0,
    ),
    JudgeRouteInfo(
      id: 5,
      buttonvisible: false,
      companypattern: 0,
      routepattern: 0,
      infopattern: 0,
    ),
    JudgeRouteInfo(
      id: 6,
      buttonvisible: false,
      companypattern: 0,
      routepattern: 0,
      infopattern: 0,
    ),
  ];

  //ボタン状態更新(メインプロセスからの戻りを格納)
  void updateItem(
    int targetId,
    bool newButtonvisible,
    int newCompanypattern,
    int newRoutepattern,
    int newInfopattern,
  ) {
    state =
        state.map((item) {
          if (item.id == targetId) {
            return item.copyWith(
              buttonvisible: newButtonvisible,
              companypattern: newCompanypattern,
              routepattern: newRoutepattern,
              infopattern: newInfopattern,
            );
          }
          return item;
        }).toList();
  }

  int countVisibleButtons() {
    return state.where((item) => item.buttonvisible).length;
  }
}

