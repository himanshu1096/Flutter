//精算経路判定ボタン構造体
class JudgeRouteInfo {
  final int id;
  final bool buttonvisible;
  final int companypattern;
  final int routepattern;
  final int infopattern;

  JudgeRouteInfo({
    required this.id,
    required this.buttonvisible,
    required this.companypattern,
    required this.routepattern,
    required this.infopattern,
  });

  JudgeRouteInfo copyWith({
    int? id,
    bool? buttonvisible,
    int? companypattern,
    int? routepattern,
    int? infopattern,
  }) {
    return JudgeRouteInfo(
      id: id ?? this.id,
      buttonvisible: buttonvisible ?? this.buttonvisible,
      companypattern: companypattern ?? this.companypattern,
      routepattern: routepattern ?? this.routepattern,
      infopattern: infopattern ?? this.infopattern,
    );
  }
}

