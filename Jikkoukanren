/// 締切実行：「実行中」ダイアログ表示 → 0x6301送信 → 0x6381待ち
/// （タイムアウト：CLOSE_TALLY_TIMEOUT_SEC）
///   RESULT=true  → true を返す（呼び出し元で完了画面へ）
///   RESULT=false → エラーメッセージJSON（無ければ既定メッセージ「締切に失敗しました」）
///   タイムアウト → 「通信エラーが発生しました」
Future<bool> _executeClose(BuildContext context) async {
  const tag = 'CloseTally';

  Future<void> showMessage(String text) async {
    if (!context.mounted) return;
    await showDialog(
      context: context,
      barrierDismissible: false,
      builder:
          (context) => CustomConfirmDialog(
            text: text,
            trueBtnText: '確認',
            hasFalseBtn: false,
          ),
    );
  }

  // 実行中ダイアログ（閉じるNavigatorを先に取得し、必ず1回だけ閉じる）
  final navigator = Navigator.of(context, rootNavigator: true);
  showCustomAlertDialog(context: context, text: '実行中');
  TcpService().setBlockingDialogOpen(true);
  var dialogOpen = true;
  void closeDialog() {
    TcpService().setBlockingDialogOpen(false);
    if (!dialogOpen) return;
    dialogOpen = false;
    try {
      navigator.pop();
    } catch (_) {
      // 0xFB81により既にダイアログが閉じられている場合は何もしない
    }
  }

  try {
    final response = await TcpService().sendCloseExecute();
    closeDialog();
    if (response.result) {
      AppLogger().info(tag, '締切実行 正常終了');
      return true;
    }

    AppLogger().warn(
      tag,
      '締切実行 失敗: ERRKIND=${response.errKind} ERRCODE=${response.errCode}',
    );
    if (!context.mounted) return false;
    final result = await handleServerError(
      context: context,
      errKind: response.errKind,
      errCode: response.errCode,
    );
    if (!result.handled) {
      await showMessage('締切に失敗しました\nエラーコード: ${response.errCode}');
    }
    return false;
  } catch (e) {
    closeDialog();
    AppLogger().error(tag, '締切実行エラー', e);
    await showMessage('通信エラーが発生しました');
    return false;
  }
}







