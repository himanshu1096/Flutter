  /// 日付選択（日付ボタン／その他の日付）
  /// くるくる表示 → 0x6601送信 → 0x6681待ち
  ///   RESULT=true  → 指定日のCSVを読み込み、選択日と一覧を切り替える
  ///   RESULT=false → エラーメッセージJSON（無ければ既定メッセージ）、選択日はそのまま
  ///   タイムアウト → 「通信エラーが発生しました」、選択日はそのまま
  Future<void> _onDateSelected(DateTime date) async {
    if (!mounted) return;
    const tag = 'CustomerServiceHistory';
    final day = DateUtils.dateOnly(date);

    Future<void> showMessage(String text) async {
      if (!mounted) return;
      await showDialog(
        context: context,
        barrierDismissible: false,
        builder:
            (context) => CustomConfirmDialog(
              text: text,
              trueBtnText: '確認',
              hasFalseBtn: false,
            ),
      );
    }

    // くるくる（閉じるNavigatorを先に取得し、必ず1回だけ閉じる）
    final navigator = Navigator.of(context, rootNavigator: true);
    showLoadingSpinner(context: context);
    var spinnerOpen = true;
    void closeSpinner() {
      if (!spinnerOpen) return;
      spinnerOpen = false;
      navigator.pop();
    }

    final minWait = Future.delayed(
      const Duration(milliseconds: _loadingDialogMinMs),
    );

    try {
      // 開始・終了とも選択日の 00:00:00（1日分）
      final stamp = '${day.toStringWithFormat('yyyy/MM/dd')} 00:00:00';
      final response = await TcpService().sendServiceHistoryRequest(
        start: stamp,
        end: stamp,
      );

      if (response.result) {
        // 本体側で指定日の接客履歴ファイルが作成されているため読み込む
        final records = await ServiceHistoryService().load(day);
        await minWait;
        closeSpinner();
        if (!mounted) return;
        setState(() {
          _selectedDate = day;
          _items = records.map(_toHistoryItem).toList();
        });
        return;
      }

      AppLogger().warn(
        tag,
        '0x6681 失敗: ERRKIND=${response.errKind} ERRCODE=${response.errCode}',
      );
      closeSpinner();
      if (!mounted) return;
      final result = await handleServerError(
        context: context,
        errKind: response.errKind,
        errCode: response.errCode,
      );
      if (!result.handled) {
        await showMessage('処理に失敗しました\nエラーコード: ${response.errCode}');
      }
    } catch (e) {
      closeSpinner();
      AppLogger().error(tag, '接客履歴要求エラー', e);
      await showMessage('通信エラーが発生しました');
    }
  }




