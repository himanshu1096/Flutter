  /// 接客履歴要求送信 (0x6601) Flutter → Server → 応答 (0x6681)
  /// ※接客履歴の日付ボタン・その他の日付。
  ///   [start]／[end]：「YYYY/MM/DD 00:00:00」（時刻は常に00:00:00）
  ///   ※画面は1日のみ選択のため end は start と同じ値（旧システムの期間指定に合わせた形式）
  /// ※本体側で指定日の接客履歴ファイルを作成してから応答する
  Future<ProcessResponse> sendServiceHistoryRequest({
    required String start,
    required String end,
  }) async {
    AppLogger().info(
      _tag,
      '0x6601 接客履歴要求 送信: SERVICEHISSTART=$start SERVICEHISEND=$end',
    );
    _serviceHistoryCompleter = Completer<ProcessResponse>();
    await sendPacket(
      commandId: CommandId.serviceHistoryRequest,
      json: {'SERVICEHISSTART': start, 'SERVICEHISEND': end},
    );
    return _serviceHistoryCompleter!.future.timeout(
      Duration(seconds: TcpConfig().responseTimeoutSec),
      onTimeout: () {
        AppLogger().error(_tag, '0x6601 タイムアウト');
        _serviceHistoryCompleter = null;
        throw TimeoutException('接客履歴要求タイムアウト');
      },
    );
  }

