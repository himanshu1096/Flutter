class _AnotherDateField extends StatefulWidget {
  /// その他の日付欄（タップでカレンダーダイアログを開く）
  /// 入力欄ではなく選択結果を表示するだけのため、TextFieldは使用しない
  /// （フォーカス枠・文字選択ハイライトなどテーマ由来の色が出ないようにするため）
  const _AnotherDateField();

  @override
  State<_AnotherDateField> createState() => _AnotherDateFieldState();
}

class _AnotherDateFieldState extends State<_AnotherDateField> {
  /// 選択中の日付（未選択はnull）
  DateTime? _selectedDate;

  Future<void> _showCalendarDialog() async {
    final selected = await showDialog<DateTime>(
      context: context,
      barrierDismissible: false,
      builder: (context) => _CalendarDialog(),
    );
    if (selected != null) {
      setState(() {
        _selectedDate = selected;
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    final bool hasDate = _selectedDate != null;

    // 未選択時は「その他の日付」、日付選択後はその日付を表示する
    final String label =
        hasDate ? _selectedDate!.toStringWithFormat('yyyy/MM/dd') : 'その他の日付';

    return TextFieldShadow(
      topStops: [0.0, 0.15],
      leftStops: [0.0, 0.04],
      child: GestureDetector(
        // 枠内のどこをタップしてもカレンダーを開く
        behavior: HitTestBehavior.opaque,
        onTap: _showCalendarDialog,
        child: Container(
          decoration: BoxDecoration(
            color: Colors.white,
            border: Border.all(color: Colors.black),
          ),
          alignment: Alignment.center,
          padding: const EdgeInsets.symmetric(horizontal: 8),
          child: Text(
            label,
            textAlign: TextAlign.center,
            maxLines: 1,
            overflow: TextOverflow.ellipsis,
            style: TextStyle(
              fontSize: _dateFieldFontSize,
              fontWeight: FontWeight.w700,
              color: hasDate ? Colors.black : Colors.black54,
            ),
          ),
        ),
      ),
    );
  }
}

class _CalendarDialog extends StatefulWidget {
  const _CalendarDialog();

  @override
  State<_CalendarDialog> createState() => _CalendarDialogState();
}

class _CalendarDialogState extends State<_CalendarDialog> {
  DateTime _currentMonth = DateTime(DateTime.now().year, DateTime.now().month);
  DateTime? _selectedDate;

  /// 選択可能な最新日（本日・時刻を切り捨て）
  DateTime get _maxDate {
    final n = DateTime.now();
    return DateTime(n.year, n.month, n.day);
  }

  /// 選択可能な最古日（本日から30日前）
  DateTime get _minDate => _maxDate.subtract(const Duration(days: 30));

  /// 選択可能な日付か（本日から30日前〜本日）
  /// 時刻の有無で判定がずれないよう、年月日だけで比較する
  bool _isSelectable(DateTime day) {
    final d = DateTime(day.year, day.month, day.day);
    return !d.isBefore(_minDate) && !d.isAfter(_maxDate);
  }

  /// 前月へ移動できるか
  bool get _canGoPrevious =>
      _currentMonth.isAfter(DateTime(_minDate.year, _minDate.month));

  /// 翌月へ移動できるか
  bool get _canGoNext =>
      _currentMonth.isBefore(DateTime(_maxDate.year, _maxDate.month));

  void _previousMonth() {
    if (!_canGoPrevious) return;
    setState(() {
      _currentMonth = DateTime(_currentMonth.year, _currentMonth.month - 1);
    });
  }

  void _nextMonth() {
    if (!_canGoNext) return;
    setState(() {
      _currentMonth = DateTime(_currentMonth.year, _currentMonth.month + 1);
    });
  }

  List<DateTime?> _getDaysInMonth() {
    final firstDay = DateTime(_currentMonth.year, _currentMonth.month, 1);
    final lastDay = DateTime(_currentMonth.year, _currentMonth.month + 1, 0);
    final List<DateTime?> days = [];

    // Add empty slots for days before first day of month
    for (int i = 0; i < firstDay.weekday % 7; i++) {
      days.add(null);
    }

    // Add all days in month
    for (int i = 1; i <= lastDay.day; i++) {
      days.add(DateTime(_currentMonth.year, _currentMonth.month, i));
    }

    return days;
  }

  @override
  Widget build(BuildContext context) {
    final days = _getDaysInMonth();
    final weekDays = ['日', '月', '火', '水', '木', '金', '土'];

    return Dialog(
      backgroundColor: Colors.white,
      child: Container(
        // 日付を見やすく・押しやすくするため拡大（1マス 約72×72px）
        width: 580,
        padding: const EdgeInsets.all(20),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            // Header with month navigation
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                IconButton(
                  onPressed: _canGoPrevious ? _previousMonth : null,
                  iconSize: 32,
                  icon: Icon(Icons.arrow_back_ios),
                ),
                Text(
                  '${_currentMonth.year}年${_currentMonth.month}月',
                  style: TextStyle(fontSize: 34, fontWeight: FontWeight.bold),
                ),
                IconButton(
                  onPressed: _canGoNext ? _nextMonth : null,
                  iconSize: 32,
                  icon: Icon(Icons.arrow_forward_ios),
                ),
              ],
            ),
            const SizedBox(height: 12),

            // Weekday headers
            Row(
              children:
                  weekDays
                      .map(
                        (d) => Expanded(
                          child: Center(
                            child: Text(
                              d,
                              style: TextStyle(
                                fontSize: 26,
                                fontWeight: FontWeight.bold,
                                color:
                                    d == '日'
                                        ? Colors.red
                                        : d == '土'
                                        ? Colors.blue
                                        : Colors.black,
                              ),
                            ),
                          ),
                        ),
                      )
                      .toList(),
            ),
            const SizedBox(height: 8),

            // Calendar grid
            GridView.builder(
              shrinkWrap: true,
              physics: NeverScrollableScrollPhysics(),
              gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
                crossAxisCount: 7,
                mainAxisSpacing: 6,
                crossAxisSpacing: 6,
                // 1.0で正方形のマスにし、横だけでなく縦にも広げる
                childAspectRatio: 1.0,
              ),
              itemCount: days.length,
              itemBuilder: (context, index) {
                final day = days[index];
                if (day == null) return SizedBox.shrink();

                // 選択可能な日付（本日から30日前〜本日）
                final selectable = _isSelectable(day);

                final isSelected =
                    _selectedDate != null &&
                    _selectedDate!.year == day.year &&
                    _selectedDate!.month == day.month &&
                    _selectedDate!.day == day.day;

                // 選択可能：曜日に応じた色（1行目の曜日見出しと同色）
                // 選択不可：グレー
                final Color dayColor;
                if (!selectable) {
                  dayColor = Colors.grey.shade400;
                } else if (isSelected) {
                  dayColor = Colors.white;
                } else if (day.weekday == DateTime.sunday) {
                  dayColor = Colors.red;
                } else if (day.weekday == DateTime.saturday) {
                  dayColor = Colors.blue;
                } else {
                  dayColor = Colors.black;
                }

                return GestureDetector(
                  // 範囲外は選択不可
                  onTap:
                      selectable
                          ? () {
                            setState(() {
                              _selectedDate = day;
                            });
                          }
                          : null,
                  child: Container(
                    decoration: BoxDecoration(
                      // 当日のオレンジ強調は廃止し、選択中のみ色を付ける
                      color: isSelected ? Colors.red : Colors.transparent,
                      borderRadius: BorderRadius.circular(8),
                    ),
                    child: Center(
                      child: Text(
                        '${day.day}',
                        style: TextStyle(
                          fontSize: 30,
                          color: dayColor,
                          fontWeight:
                              isSelected ? FontWeight.bold : FontWeight.normal,
                        ),
                      ),
                    ),
                  ),
                );
              },
            ),
            const SizedBox(height: 16),

            // 確定/取消 buttons
            Row(
              mainAxisAlignment: MainAxisAlignment.end,
              spacing: 16,
              children: [
                OutlinedButton(
                  onPressed: () => Navigator.of(context).pop(),
                  style: OutlinedButton.styleFrom(
                    minimumSize: const Size(140, 60),
                  ),
                  child: Text('取消', style: TextStyle(fontSize: 26)),
                ),
                ElevatedButton(
                  onPressed:
                      _selectedDate == null
                          ? null
                          : () => Navigator.of(context).pop(_selectedDate),
                  style: ElevatedButton.styleFrom(
                    backgroundColor: Colors.blue,
                    foregroundColor: Colors.white,
                    minimumSize: const Size(140, 60),
                  ),
                  child: Text('確定', style: TextStyle(fontSize: 26)),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }
}
