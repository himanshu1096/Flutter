class _PageNumberButtons extends StatelessWidget {
  final int currentPage;
  final int totalPages;
  final void Function(int page) onSelected;

  const _PageNumberButtons({
    required this.currentPage,
    required this.totalPages,
    required this.onSelected,
  });

  @override
  Widget build(BuildContext context) {
    // 1ページしかない場合は表示しない
    if (totalPages <= 1) return const SizedBox.shrink();

    return Padding(
      padding: const EdgeInsets.only(bottom: 4.0),
      child: Row(
        mainAxisSize: MainAxisSize.min,
        mainAxisAlignment: MainAxisAlignment.center,
        spacing: 12,
        children: [
          for (int i = 0; i < totalPages; i++)
            _PageNumberButton(
              pageNo: i + 1,
              selected: i == currentPage,
              onPressed: i == currentPage ? null : () => onSelected(i),
            ),
        ],
      ),
    );
  }
}

// ignore: unused_element
class _PageNumberButton extends StatelessWidget {
  final int pageNo;
  final bool selected;
  final VoidCallback? onPressed;

  const _PageNumberButton({
    required this.pageNo,
    required this.selected,
    required this.onPressed,
  });

  @override
  Widget build(BuildContext context) {
    final label = Padding(
      padding: const EdgeInsets.symmetric(horizontal: 18.0, vertical: 6.0),
      child: Text(
        '$pageNo',
        style: _btnTextStyle.merge(
          TextStyle(
            fontWeight: selected ? FontWeight.w700 : FontWeight.w400,
            color: selected ? Colors.black : AppColor.grey.no700,
          ),
        ),
      ),
    );

    // 選択中は凹ボタン、未選択は凸ボタンで現在位置を表現する
    if (selected) {
      return SetBackButton(
        backgroundColors: orengeGradient,
        onPressed: null,
        child: label,
      );
    }
    return PopOutButton(
      backgroundColors: AppColor.grey.gradientLightColors,
      onPressed: onPressed,
      child: label,
    );
  }
}

