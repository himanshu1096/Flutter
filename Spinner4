/// くるくるの最低表示時間（ミリ秒）
/// ※応答がすぐ返る場合に一瞬で消えてちらつかないようにする
const int _spinnerMinMs = 300;

/// 関連業務選択：0x0C81送信 → 0x0C01受信 → 各画面のデータ読み込み
/// 待っている間はくるくるを表示し、画面を操作不可にする
///   RESULT=true  → 締切系：締切ファイル読み込み（締切再出力は締切履歴日時も保存）
///                  接客履歴：CSV再読み込みを通知
///   RESULT=false → KbaErrorMessage.json のエラーダイアログ
///   タイムアウト → 「通信エラーが発生しました」
/// タイムアウト：日計締切は CLOSE_TALLY_TIMEOUT_SEC、その他は RESPONSE_TIMEOUT_SEC
Future<void> _selectRelation(
  BuildContext context,
  WidgetRef ref,
  _RelatedProcessTab tab,
  int relationNumber,
) async {
  const tag = 'RelatedProcess';
  final isCloseTab =
      tab == _RelatedProcessTab.closeTally ||
      tab == _RelatedProcessTab.closeQuick ||
      tab == _RelatedProcessTab.closeTallyRe;
  final closeTally = ref.read(closeTallyDataProvider.notifier);
  final historyDates = ref.read(closeHistoryDatesProvider.notifier);

  // 前回の表示を残さない
  if (isCloseTab) closeTally.clear();
  if (tab == _RelatedProcessTab.closeTallyRe) historyDates.clear();

  // くるくる表示（画面操作不可）
  // ※閉じるNavigatorを先に取得しておき、必ず1回だけ閉じる
  final navigator = Navigator.of(context, rootNavigator: true);
  showLoadingSpinner(context: context);
  var spinnerOpen = true;
  void closeSpinner() {
    if (!spinnerOpen) return;
    spinnerOpen = false;
    navigator.pop();
  }

  final minWait = Future.delayed(const Duration(milliseconds: _spinnerMinMs));

  try {
    final response = await TcpService().sendRelationRequest(
      relationNumber,
      // 日計締切はデータ作成に時間がかかるため、専用のタイムアウトを使う
      timeoutSec:
          tab == _RelatedProcessTab.closeTally
              ? TcpConfig().closeTallyTimeoutSec
              : null,
    );

    if (response.result) {
      AppLogger().info(tag, '0x0C01 正常: RELATIONNUMBER=$relationNumber');
      if (isCloseTab) await closeTally.load();
      if (tab == _RelatedProcessTab.closeTallyRe) {
        historyDates.set(response.properties);
      }
      if (tab == _RelatedProcessTab.history) {
        ref.read(serviceHistoryReloadProvider.notifier).notify();
      }
      await minWait;
      closeSpinner();
      return;
    }

    // RESULT=false：KbaErrorMessage.json のエラーダイアログ
    AppLogger().warn(
      tag,
      '0x0C01 失敗: ERRKIND=${response.errKind} ERRCODE=${response.errCode}',
    );
    closeSpinner();
    if (!context.mounted) return;
    final result = await handleServerError(
      context: context,
      errKind: response.errKind,
      errCode: response.errCode,
    );
    if (!result.handled && context.mounted) {
      await showDialog(
        context: context,
        barrierDismissible: false,
        builder:
            (context) => CustomConfirmDialog(
              text: '処理に失敗しました\nエラーコード: ${response.errCode}',
              trueBtnText: '確認',
              hasFalseBtn: false,
            ),
      );
    }
  } catch (e) {
    // タイムアウト・通信エラー（QR読取と同じダイアログ）
    AppLogger().error(tag, '0x0C81 エラー: RELATIONNUMBER=$relationNumber', e);
    closeSpinner();
    if (context.mounted) {
      await showDialog(
        context: context,
        barrierDismissible: false,
        builder:
            (context) => CustomConfirmDialog(
              text: '通信エラーが発生しました',
              trueBtnText: '確認',
              hasFalseBtn: false,
            ),
      );
    }
  }
}

