/// ページ送りの方向
enum _PagerDirection { previous, next }

/// 出力方法（印刷／外部媒体出力）の選択状態
enum _OutputMethod { print, externalMedia }

/// 1ページあたりの表示件数（実データ接続時にpage数の根拠となる。現状はモックデータに合わせた仮値）
const int _itemsPerPage = 3;

final TextStyle _btnTextStyle = TextStyle(fontSize: fontSize);

class CustomerServiceHistory extends StatefulWidget {
  const CustomerServiceHistory({super.key});

  @override
  State<CustomerServiceHistory> createState() =>
      _CustomerServiceHistoryState();
}

class _CustomerServiceHistoryState extends State<CustomerServiceHistory> {
  // null = 未選択、0〜7 = 過去8日分のボタン、8 = 全接客履歴ボタン
  int? _selectedDateIndex;
  _OutputMethod? _selectedOutput;
  int _currentPage = 0;

  void _onSelectDate(int index) {
    setState(() {
      _selectedDateIndex = index;
    });
  }

  void _onSelectOutput(_OutputMethod method) {
    setState(() {
      // 同じボタンを再度押した場合は選択解除（トグル）
      _selectedOutput = _selectedOutput == method ? null : method;
    });
  }

  void _onChangePage(int delta) {
    setState(() {
      _currentPage += delta;
    });
  }

  // 外部媒体出力ボタンが有効になる条件。
  // 本来は外部媒体（USBメモリ等）の接続検知結果を参照する想定だが、
  // 現時点ではバックエンド未接続のためUI確認用にtrue固定としている。
  bool get _externalMediaConnected => true;

  @override
  Widget build(BuildContext context) {
    return PaddingForContent(
      child: Column(
        spacing: 8,
        children: [
          _TitleAndMessage(),
          Flexible(
            flex: 3,
            child: _HistoryView(
              currentPage: _currentPage,
              onChangePage: _onChangePage,
            ),
          ),
          Flexible(
            flex: 1,
            child: _FooterControllers(
              selectedDateIndex: _selectedDateIndex,
              onSelectDate: _onSelectDate,
              selectedOutput: _selectedOutput,
              onSelectOutput: _onSelectOutput,
              externalMediaConnected: _externalMediaConnected,
              // 実行ボタンは印刷／外部媒体出力のいずれかが選択されている場合のみ有効。
              // バックエンド接続前のため、押下時の処理は現状空。
              onExecute: _selectedOutput == null ? null : () {},
            ),
          ),
        ],
      ),
    );
  }
}

