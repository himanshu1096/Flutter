/// 接客履歴日時（過去8日分）＋全接客履歴の選択ボタン群
class _SelectDateBottons extends StatelessWidget {
  final int? selectedIndex;
  final void Function(int index) onSelect;

  const _SelectDateBottons({required this.selectedIndex, required this.onSelect});

  // 過去8日分のボタンの後、全接客履歴ボタンのインデックスとして使用
  static const int allHistoryIndex = 8;

  @override
  Widget build(BuildContext context) {
    return Column(
      mainAxisSize: MainAxisSize.min,
      spacing: 8,
      children: [
        // 全接客履歴ボタン（15.9.2：接客履歴日時ボタンとは別に選択可能）
        SizedBox(
          width: double.infinity,
          height: 36,
          child: _buildDateButton(
            index: allHistoryIndex,
            colors: AppColor.teal.gradientColors,
            label: '全接客履歴',
          ),
        ),
        GridView(
          padding: EdgeInsets.only(top: 0, bottom: 0),
          gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
            crossAxisCount: 4,
            crossAxisSpacing: 8,
            mainAxisSpacing: 8,
            childAspectRatio: 4 / 1,
          ),
          children: [
            _buildDateButton(
              index: 0,
              colors: AppColor.orange.gradientColors,
              label: '当日',
              foregroundColor: Colors.black,
            ),
            // 過去日一週間分のボタン
            for (var i = 1; i < 8; i++)
              _buildDateButton(
                index: i,
                colors: AppColor.blueGrey.gradientColors,
                label: DateTime.now().add(Duration(days: -i)).toDateOnlyString(),
              ),
          ],
        ),
      ],
    );
  }

  Widget _buildDateButton({
    required int index,
    required List<Color> colors,
    required String label,
    Color foregroundColor = Colors.white,
  }) {
    final isSelected = selectedIndex == index;
    final textWidget = Text(
      label,
      style: _btnTextStyle.merge(TextStyle(color: foregroundColor)),
    );
    // 選択中はSetBackButton（凹＝押下状態）、未選択はPopOutButton（凸）で表現。
    // これはアプリ内の他のボタン（业務ボタン等）と同じ選択表現の慣習に合わせている。
    if (isSelected) {
      return SetBackButton(
        backgroundColors: colors,
        onPressed: () => onSelect(index),
        child: textWidget,
      );
    }
    return PopOutButton(
      backgroundColors: colors,
      onPressed: () => onSelect(index),
      child: textWidget,
    );
  }
}

